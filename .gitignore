# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary
*.tmp
*.bak

# Python
__pycache__/
*.egg-info/
uv.lock

# Execution traces (local-only, generated per session)
quality_reports/traces/*.jsonl
quality_reports/token_baselines/*.tsv

# Cross-repo learning corpus (contains private war stories; local-only)
quality_reports/learning_corpus/

# Python virtual environments
.venv/

# Client-specific skills extracted to private repos, symlinked in.
# No trailing slash: these are symlinks, which git treats as files, not dirs.
skills/*-hikma
skills/*-wishew
skills/_wishew_shared
# Standalone external skill repo, symlinked in (own repo: claude-advanced-review)
skills/advanced-review

# Machine-local symlink into the claude-advanced-review repo (deployed skill, lives elsewhere)
/skills/advanced-review
