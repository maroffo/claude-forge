{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_": "Merge this into ~/.claude/settings.json under 'permissions', 'hooks', and the top-level keys below. Replace {{HOOKS_DIR}} with the absolute path to your installed hooks (typically /Users/<you>/.claude/hooks or /home/<you>/.claude/hooks).",
  "_comment_effortLevel": "Tuned for Opus 4.8: xhigh is Anthropic's recommended effort for coding/agentic work. Drop the global default to 'high' if most sessions are light; bump heavy ones per-task with /effort. Omit the key entirely to use the model default. Note: 4.8 recalibrated effort, do not assume 4.7 token costs. To pin the model add \"model\": \"opus\" (alias resolves to latest Opus, never goes stale).",
  "effortLevel": "xhigh",
  "permissions": {
    "deny": [
      "Edit(**/.git/hooks/**)",
      "Write(**/.git/hooks/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.aws/credentials)",
      "Write(~/.aws/credentials)",
      "Edit(~/.config/gcloud/**)",
      "Write(~/.config/gcloud/**)",
      "Edit(**/id_rsa)",
      "Edit(**/id_ed25519)",
      "Write(**/id_rsa)",
      "Write(**/id_ed25519)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/pre-commit-gate.sh", "if": "Bash(git commit*)", "timeout": 600, "statusMessage": "Running make check + make test-e2e..." },
          { "type": "command", "command": "{{HOOKS_DIR}}/main-branch-guard.sh", "if": "Bash(git commit*)", "timeout": 10 },
          { "type": "command", "command": "{{HOOKS_DIR}}/commit-intent-guard.sh", "if": "Bash(git commit*)", "timeout": 10 },
          { "type": "command", "command": "{{HOOKS_DIR}}/gitignore-anchor-lint.sh", "if": "Bash(git commit*)", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/aboutme-enforcer.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/aboutme-enforcer.sh", "timeout": 10 },
          { "type": "command", "command": "{{HOOKS_DIR}}/routing-advisor.sh", "timeout": 10 },
          { "type": "command", "command": "{{HOOKS_DIR}}/doom-loop-detector.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/routing-advisor.sh", "timeout": 10 },
          { "type": "command", "command": "{{HOOKS_DIR}}/doom-loop-detector.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/routing-advisor.sh", "timeout": 10 },
          { "type": "command", "command": "{{HOOKS_DIR}}/doom-loop-detector.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/routing-advisor.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/codemap-session.sh", "timeout": 20 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/verify-before-stop.sh", "timeout": 15 },
          { "type": "command", "command": "{{HOOKS_DIR}}/score-evidence-guard.sh", "timeout": 15 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "{{HOOKS_DIR}}/session-end-trace.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
